{
  "hosting": {
    "public": "assets/hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/custom-css/@(prod|staging)/eventsystem/organizers/*/styles.css",
        "destination": "/custom-css/empty.css"
      },
      {
        "source": "/custom-css/@(prod|staging)/eventsystem/organizers/*/events/*/styles.css",
        "destination": "/custom-css/empty.css"
      },
      {
        "source": "/custom-js/@(prod|staging)/eventsystem/organizers/*/script.js",
        "destination": "/custom-js/empty.js"
      },
      {
        "source": "/custom-js/@(prod|staging)/eventsystem/organizers/*/events/*/script.js",
        "destination": "/custom-js/empty.js"
      }
    ],
    "headers": [
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=31536000"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=31536000"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|avif|svg|mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, s-maxage=31536000"
          }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|otf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, s-maxage=31536000"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5055
    },
    "ui": {
      "enabled": false
    }
  }
}
